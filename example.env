# Example environment for the species deployment.
# For a quick start, run ./init.sh instead of copying this file; it fills in
# the values below, copies the shared MySQL/Keycloak secrets from
# emobase-infra, and generates the remaining secrets.
#
# 4-letter code of your species (e.g. Tcas, Dmel, Ptep)
MAIN_SPECIES=Tcas

# Web UI image
EMOBASE_WEB_IMAGE=ghcr.io/emobase/emobase-web:dev

# Local image build instead of pulling from GHCR:
#   docker compose -f compose.yml -f compose.local.yml up -d --build
# Point this at the source checkout; the default assumes it sits next to this
# checkout.
# EMOBASE_WEB_DIR=../emobase-web

# Public origin of the multi-species portal deployment (the portal's own
# PUBLIC_SERVER). The genomics API, JBrowse2 and BLAST links point here.
# Do not include a trailing slash. `init.sh --portal-dir ../portal`
# copies this value from the portal checkout automatically.
PORTAL_SERVER=https://portal.example.com

# Portal origin used from inside this deployment's containers (BLAST proxy and
# server-side API calls). init.sh derives it automatically:
#   - local portal checkout: http://host.docker.internal:<portal port>;
#   - remote portal: leave empty, Compose falls back to PORTAL_SERVER.
# Set an explicit value only when the portal is reachable at another private
# address (VPN, internal DNS name).
PORTAL_INTERNAL_URL=

# Internal service URLs for server-side calls. These override the matching
# PUBLIC_* URLs inside the server. They must be absolute URLs.
# Use the portal's public URL here when it is on a different server.
INTERNAL_API_GENOMICS_SERVICE=https://portal.example.com/api/genomicsservice/v1
INTERNAL_API_PHENOTYPE_SERVICE=http://phenotypeservice:8080
INTERNAL_API_IMAGE_SERVICE=http://imageservice:8080
INTERNAL_API_ONTOLOGY_SERVICE=http://ontologyservice:8080
INTERNAL_API_GO_ANNOTATION_SERVICE=http://goannotationservice:8080
INTERNAL_API_PUBLICATION_SERVICE=http://publicationservice:8080
INTERNAL_API_QUERY_PIPELINE_SERVICE=http://querypipelineservice:8080
# Server-side Keycloak calls go to the local emobase-infra Keycloak. For a
# same-host deployment use the published Keycloak port or the public auth URL.
INTERNAL_KEYCLOAK_ISSUER=http://host.docker.internal:8181/keycloak/realms/emobase-tcas
INTERNAL_DIRECTUS_URL=http://directus:8055

# ── Shared infrastructure ───────────────────────────────────────────────────
# MySQL, Keycloak and Elasticsearch run in the sibling emobase-infra stack.
# Start it first. This stack joins its Docker network; the service names below
# resolve there.
EMOBASE_INFRA_NETWORK=emobase-infra
DIRECTUS_DB_HOST=mysql
DIRECTUS_DB_PORT=3306
DIRECTUS_DB_USER=root
# One database per species. Create it with
# emobase-infra/scripts/create-database.sh before starting Directus.
DIRECTUS_DB_DATABASE=directus_tcas

# Elasticsearch is shared with the portal and every species stack. This stack
# reaches it through its es-proxy sidecar and writes only <prefix>-* indices.
# Lowercase letters, digits, underscore and hyphen only; "genomics" is
# reserved for the portal.
EMOBASE_ES_INDEX_PREFIX=tcas

# Keycloak endpoint/realm/client. The public URL is used by the browser; the
# internal URL is used by containers on the shared infra network.
KEYCLOAK_PUBLIC_URL=http://localhost:8181/keycloak
KEYCLOAK_INTERNAL_URL=http://keycloak:8080/keycloak
KEYCLOAK_REALM=emobase-tcas
KEYCLOAK_REALM_MODE=dedicated
KEYCLOAK_CLIENT_ID=emobase-tcas-client
# Keycloak URL used by Directus from inside the shared infra network.
DIRECTUS_KEYCLOAK_ISSUER_URL=http://keycloak:8080/keycloak/realms/emobase-tcas

# The full address to access this species site from public (for swagger-ui).
# Must match the host used in the browser: the BLAST iframe uses it as an
# absolute URL. This is NOT the portal URL; that is PORTAL_SERVER above.
PUBLIC_SERVER=http://localhost:9090

# Hostname part of PUBLIC_SERVER (no protocol, port or path). The species nginx
# answers only this name and rejects other Host headers, so use PUBLIC_SERVER
# when opening the site.
PUBLIC_HOST=localhost

# Host port for the local reverse proxy. Published on 127.0.0.1 only, so a
# direct client on another machine cannot reach the app; use the public URL.
HTTP_PORT=9090

# Directory for storing data that is publicly downloadable
PUBLIC_DATA_DIR=./data/public

# Directory for storing private data used by internal services
PRIVATE_DATA_DIR=./data/private

# Directory for storing uploaded images
IMAGE_DIR=./images

# uid and gid of the user who can write to the image directory
UID=1001
GID=1001

# Shared MySQL root password. Must match the infra checkout's .env.
MYSQL_ROOT_PASSWORD=youshallnotpass

# This should be a at least 48 characters random string
NUXT_OIDC_SESSION_SECRET=

# This needs to be a random cryptographic AES key in base64
NUXT_OIDC_TOKEN_KEY=

# This should be a at least 48 characters random string
NUXT_OIDC_AUTH_SESSION_SECRET=

# Client secret for KEYCLOAK_REALM. It is copied when joining a realm or
# generated when creating a new realm.
KEYCLOAK_CLIENT_SECRET=

# Seed Keycloak user. It is copied when joining a realm or generated when
# creating a new realm.
COCO_USERNAME=coco
COCO_PASSWORD=

# Project name (prefix for containers)
COMPOSE_PROJECT_NAME=ibb

# Compose files. Tcas adds its species overlay so plain `docker compose`
# commands include OBA, Ontoscope and the extended Swagger UI.
COMPOSE_FILE=compose.yml:compose.tcas.yml

# Optional: override the OBA Java 7 runtime.
# OBA_IMAGE=azul/zulu-openjdk:7
