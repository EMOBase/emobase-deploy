# Example environment for the species deployment.
# For a quick start, run ./init.sh instead of copying this file; it fills in
# the values below and generates all secrets.
#
# 4-letter code of your species (e.g. Tcas, Dmel, Ptep)
MAIN_SPECIES=Tcas

# Web UI image
EMOBASE_WEB_IMAGE=ghcr.io/emobase/emobase-web:dev

# Public origin of the multi-species portal deployment (the portal's own
# PUBLIC_SERVER). The genomics API, JBrowse2 and BLAST links point here.
# Do not include a trailing slash. `init.sh --portal-dir ../emobase-portal-deploy`
# copies this value from the portal checkout automatically.
PORTAL_SERVER=https://portal.example.com

# Portal origin used from inside this deployment's containers (BLAST proxy and
# server-side API calls). Leave equal to PORTAL_SERVER when the portal is on a
# different server. For same-host Docker, use an internal address such as
# http://host.docker.internal:9091; init.sh --local sets this automatically.
PORTAL_INTERNAL_URL=https://portal.example.com

# Internal service URLs for server-side calls. These override the matching
# PUBLIC_* URLs inside the server. They must be absolute URLs.
# Use the portal's public URL here when it is on a different server.
INTERNAL_API_GENOMICS_SERVICE=https://portal.example.com/ibb/api/genomicsservice/v1
INTERNAL_API_PHENOTYPE_SERVICE=http://phenotypeservice:8080
INTERNAL_API_IMAGE_SERVICE=http://imageservice:8080
INTERNAL_API_ONTOLOGY_SERVICE=http://ontologyservice:8080
INTERNAL_API_GO_ANNOTATION_SERVICE=http://goannotationservice:8080
INTERNAL_API_PUBLICATION_SERVICE=http://publicationservice:8080
INTERNAL_API_QUERY_PIPELINE_SERVICE=http://querypipelineservice:8080
INTERNAL_KEYCLOAK_ISSUER=http://keycloak:8080/ibb/keycloak/realms/ibb
INTERNAL_DIRECTUS_URL=http://directus:8055

# The full address to access this species site from public (for swagger-ui).
# Must match the host used in the browser: the BLAST iframe uses it as an
# absolute URL. This is NOT the portal URL; that is PORTAL_SERVER above.
PUBLIC_SERVER=http://localhost:9090

# The name of this machine. Should be the same as PUBLIC_SERVER without the protocol and port
HOSTNAME=localhost

# The port to access the app from local
HTTP_PORT=9090

# Directory for storing data that is publicly downloadable
PUBLIC_DATA_DIR=./data/public

# Directory for storing private data used by internal services
PRIVATE_DATA_DIR=./data/private

# Directory for storing uploaded images
IMAGE_DIR=./images

# uid and gid of the user who can write to the image directory
UID=1001
GID=1001

# Credentials to login to user management page at $PUBLIC_SERVER/ibb/keycloak/
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# Keycloak database password
MYSQL_ROOT_PASSWORD=youshallnotpass

# This should be a at least 48 characters random string
NUXT_OIDC_SESSION_SECRET=

# This needs to be a random cryptographic AES key in base64
NUXT_OIDC_TOKEN_KEY=

# This should be a at least 48 characters random string
NUXT_OIDC_AUTH_SESSION_SECRET=

# In ibb realm of the keycloak instance, there must be a client with the name ibb-client. This is the secret of that client
KEYCLOAK_CLIENT_SECRET=

# Project name (prefix for containers)
COMPOSE_PROJECT_NAME=ibb
