events {
}

http {
  # Preserve X-Forwarded-Host set by an upstream reverse proxy; fall back to
  # the Host header seen by nginx when no upstream value is present.
  map $http_x_forwarded_host $forwarded_host {
    "" $http_host;
    default $http_x_forwarded_host;
  }

  # Preserve X-Forwarded-Proto set by an upstream reverse proxy; fall back to
  # the scheme seen by nginx when no upstream value is present.
  map $http_x_forwarded_proto $forwarded_proto {
    "" $scheme;
    default $http_x_forwarded_proto;
  }
  proxy_buffer_size 128k;
  proxy_buffers 4 256k;
  proxy_busy_buffers_size 256k;

  server {

    # This is the internal docker dns server, cache for 30 seconds
    resolver 127.0.0.11 valid=30s;

    # Auth.js/Keycloak/Directus cookies can exceed nginx's 8k default header
    # buffer. Keep the initial buffer small; large headers use the on-demand
    # large buffers.
    client_header_buffer_size 4k;
    large_client_header_buffers 4 16k;
    client_header_timeout 10s;

    location / {
      # Using the variable trick, nginx will now start even if the upstream host is not yet reachable.
      # Inside docker, need the resolver to work.
      set $upstream http://fe:8080;
      proxy_pass $upstream;

      # Needed for keycloak authentication, don't know why
      proxy_set_header Host $http_host;
      # Astro only trusts the public scheme when this is forwarded.
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
    }
    location /download/ {
      alias /download/;
      autoindex on;
      add_header Access-Control-Allow-Origin *;
    }

    # Proxy BLAST instead of using the portal URL directly: its iframe
    # submits a CSRF-protected form tied to a SequenceServer session cookie,
    # which the browser would not send across origins. Same-origin keeps the
    # cookie first-party.
    location /ibb/blast/ {
      proxy_pass ${PORTAL_SERVER}/ibb/blast/;
      proxy_set_header Host $http_host;
      proxy_set_header X-Forwarded-Host $forwarded_host;
      proxy_set_header X-Forwarded-Proto $forwarded_proto;
      proxy_read_timeout 180s;
      proxy_ssl_server_name on;
    }
    # # Uncomment to allow access to elasticsearch from outside, useful for data backup or restore.
    # # Very insecure so turn off when not needed
    # location /ibb/es {
    #   set $upstream es;
    #   proxy_pass http://$upstream:9200;
    #   rewrite ^/ibb/es/(.*)$ /$1 break;
    # }
    location /ibb/keycloak/ {
      set $upstream keycloak;
      proxy_pass http://$upstream:8080;
    }

    location /ibb/directus/ {
      set $upstream http://directus:8055;
      proxy_pass $upstream;
      rewrite ^/ibb/directus/(.*)$ /$1 break;
    }

    location /oba {
      set $upstream http://oba:9998;
      proxy_pass $upstream;
      rewrite ^/oba/(.*)$ /$1 break;
    }
    location /ibb/ontoscope {
      set $upstream ontoscope;
      proxy_pass http://$upstream:80;
    }
    location /ibb/swagger-ui {
      set $upstream swagger-ui;
      proxy_pass http://$upstream:8080;
    }
    location /ibb/api/ontologyservice {
      set $upstream http://ontologyservice:8080;
      proxy_pass $upstream;
      rewrite ^/ibb/api/ontologyservice/v1/(.*)$ /$1 break;
    }
    location /ibb/api/imageservice {
      set $upstream http://imageservice:8080;
      proxy_pass $upstream;
      rewrite ^/ibb/api/imageservice/v1/(.*)$ /$1 break;
    }
    location /ibb/api/phenotypeservice {
      set $upstream http://phenotypeservice:8080;
      proxy_pass $upstream;
      rewrite ^/ibb/api/phenotypeservice/v1/(.*)$ /$1 break;
    }
    location /ibb/api/goannotationservice {
      set $upstream http://goannotationservice:8080;
      proxy_pass $upstream;
      rewrite ^/ibb/api/goannotationservice/v1/(.*)$ /$1 break;
    }
    location /ibb/api/publicationservice {
      set $upstream http://publicationservice:8080;
      proxy_pass $upstream;
      rewrite ^/ibb/api/publicationservice/v1/(.*)$ /$1 break;
    }
    location /ibb/api/querypipelineservice {
      set $upstream http://querypipelineservice:8080;
      proxy_pass $upstream;
      rewrite ^/ibb/api/querypipelineservice/v1/(.*)$ /$1 break;
    }
  }
}
