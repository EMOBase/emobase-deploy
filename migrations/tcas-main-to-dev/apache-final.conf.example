# Reference for the final Tcas vhost.
# ./apache-apply.sh generates the real file from migration.env and installs it.
# Do not edit this file: review with `sudo ./apache-apply.sh --dry-run`, and
# set SSL_CERT_FILE / SSL_CERT_KEY_FILE in migration.env when detection fails.

<VirtualHost *:443>
    ServerName tcas.example.org

    SSLEngine on
    SSLCertificateFile    /etc/letsencrypt/live/tcas.example.org/fullchain.pem
    SSLCertificateKeyFile /etc/letsencrypt/live/tcas.example.org/privkey.pem

    ProxyPreserveHost On
    RequestHeader set X-Forwarded-Proto "https"
    LimitRequestFieldSize 16384

    ProxyPass        /  http://127.0.0.1:9092/
    ProxyPassReverse /  http://127.0.0.1:9092/
</VirtualHost>
