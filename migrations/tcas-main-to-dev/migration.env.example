# Generated by ./migrate.sh init, or copy this file to migration.env.
# Do not commit migration.env if it contains real values you consider private.

# Paths
OLD_SPECIES_DIR=/srv/emobase/Tcas
NEW_WORKSPACE=/srv/emobase-migration
BACKUP_DIR=/srv/emobase-migration/backup

# Public URLs
TCAS_URL=https://tcas.example.org
PORTAL_URL=https://portal.example.org
KEYCLOAK_PUBLIC_URL=https://tcas.example.org/keycloak

# Optional Apache certificate overrides for ./migrate.sh apache.
# Set these before running it, or rerun apache after changing them.
# If unset, it detects Let's Encrypt and common mkcert paths for TCAS_URL's host.
# SSL_CERT_FILE=
# SSL_CERT_KEY_FILE=

# New stack ports
NEW_HTTP_PORT=9092
NEW_ES_PORT=9204

# New Compose project (must differ from the old one)
NEW_PROJECT=tcas

# Species and Keycloak names
SPECIES_CODE=Tcas
REALM=ibb
CLIENT_ID=ibb-client

# Optional. If empty, the script reads KEYCLOAK_ADMIN and
# KEYCLOAK_ADMIN_PASSWORD from OLD_SPECIES_DIR/.env.
OLD_KEYCLOAK_ADMIN=
OLD_KEYCLOAK_ADMIN_PASSWORD=

# The old HTTP port, project name and data paths are read from
# OLD_SPECIES_DIR/.env.
#
# IMAGE_MODE
# auto   detect the old IMAGE_DIR layout:
#          absolute path (direct NFS) -> reuse it unchanged, copy nothing
#          whole symlink or mount     -> make ./images a symlink to the target
#          symlink farm               -> bind-mount the real directory (see below)
#          real files                 -> copy them into ./images
# copy   always copy the images into ./images. Symlinks are materialized; use
#        it when the source is read-only or not shared with the new stack.
# mount  bind-mount IMAGE_MOUNT_SOURCE read-only into imageservice and
#        phenotypeservice via compose.media.yml. For symlink farms, where the
#        files live outside the checkout and should not be copied.
IMAGE_MODE=auto
# Only used by IMAGE_MODE=mount. The host directory that holds the image files.
# When empty, it is derived from the old IMAGE_DIR symlink targets.
IMAGE_MOUNT_SOURCE=
#
# Elasticsearch
# snapshot  take a fresh snapshot of the old cluster during transfer, copy it to
#           the new infra Elasticsearch and restore the indices with the new
#           prefix. Recommended: the old data/private directories are empty and
#           the ontology, GO annotation and publication services have no local
#           data to rebuild from.
# rebuild   skip the snapshot and restore. The new services rebuild their
#           indices from the copied data; existing <prefix>-* indices in the new
#           Elasticsearch are deleted first. Only use it when every service can
#           rebuild, and the old full_backup_<date> snapshot is not a
#           substitute for a fresh one.
# Do not copy the old es-data volume between Elasticsearch versions.
ES_MODE=snapshot

# Repositories
DEPLOY_REPO=https://github.com/EMOBase/emobase-deploy.git
INFRA_REPO=https://github.com/EMOBase/emobase-infra.git

# Image tag for the new species UI
EMOBASE_WEB_IMAGE=ghcr.io/emobase/emobase-web:dev

# Docker Hub removed openjdk:7. This is the Java 7 image the OBA jar is known
# to run with. Override only if your deployment uses a different image.
OBA_IMAGE=jboss/base-jdk:7
