# Copy to migration.env and fill in the paths and URLs.
# Do not commit migration.env if it contains real values you consider private.

# Absolute paths
OLD_SPECIES_DIR=/srv/emobase/Tcas
NEW_WORKSPACE=/srv/emobase-migration
BACKUP_DIR=/srv/emobase-migration/backup

# Public URLs
TCAS_URL=https://tcas.example.org
STAGING_URL=https://tcas.example.org:9443
PORTAL_URL=https://portal.example.org
KEYCLOAK_PUBLIC_URL=https://tcas.example.org/keycloak

# New stack ports
NEW_HTTP_PORT=9092
NEW_ES_PORT=9204

# New Compose project (must differ from the old one)
NEW_PROJECT=tcas

# Species and Keycloak names
SPECIES_CODE=Tcas
REALM=ibb
CLIENT_ID=ibb-client

# Optional. If empty, the script reads KEYCLOAK_ADMIN and
# KEYCLOAK_ADMIN_PASSWORD from OLD_SPECIES_DIR/.env.
OLD_KEYCLOAK_ADMIN=
OLD_KEYCLOAK_ADMIN_PASSWORD=

# The old HTTP port, project name and data paths are read from
# OLD_SPECIES_DIR/.env. PUBLIC_DATA_DIR may be an absolute external mount; it
# is reused read-only and is never copied by this script.
#
# IMAGE_MODE=auto detects the old layout:
#   - absolute IMAGE_DIR (e.g. /media/ibeetleb/images) -> use the same absolute
#     path directly; no copy, no compose.media.yml
#   - ./images is a symlink or NFS bind mount -> link the new images directory
#     to the same target (no copy, no compose.media.yml)
#   - ./images is a directory of symlinks     -> write compose.media.yml and
#     mount the target read-only; keep community-data local/writable
#   - ./images is a directory of real files   -> copy into the new checkout
#
# IMAGE_MODE=copy forces a 3.9 GB materialized copy into ./images.
# IMAGE_MODE=mount forces the symlink-farm layout; it is not valid for real files.
# Note: imageservice requires /images/community-data to be writable. If the
# whole image directory is read-only NFS, use copy or a writable overlay.
IMAGE_MODE=auto
IMAGE_MOUNT_SOURCE=
#
# Elasticsearch: snapshot takes a fresh snapshot from the old cluster and
# restores it with the new index prefix. rebuild is only for deployments whose
# services can rebuild every index from their data directories.
ES_MODE=snapshot

# Repositories
DEPLOY_REPO=https://github.com/EMOBase/emobase-deploy.git
INFRA_REPO=https://github.com/EMOBase/emobase-infra.git

# Image tag for the new species UI
EMOBASE_WEB_IMAGE=ghcr.io/emobase/emobase-web:dev

# The old server needed this image because openjdk:7 has no working entrypoint
# for the OBA jar. Override only if your deployment uses a different image.
OBA_IMAGE=jboss/base-jdk:7
